rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🚨 EMERGENCY REPORTS
    match /reports/{reportId} {
      allow read, write: if true; 
    }

    // 🤝 VOLUNTEERS
    match /volunteers/{volunteerId} {
      allow read, write: if true;
    }

    // 📋 TASKS
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // 🧩 CLUSTERS
    match /clusters/{clusterId} {
      allow read, write: if true;
    }

    // 📊 INSIGHTS
    match /insights/{insightId} {
      allow read, write: if true;
    }
  }
}
